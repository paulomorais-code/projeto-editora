NODE_ENV=development
PORT=3333
HOST=127.0.0.1
DATABASE_URL=postgresql://nascente:nascente@localhost:5433/nascente?schema=public
FRONTEND_ORIGIN=http://localhost:5500
# true somente quando a API roda atrás de proxy reverso (Nginx/Cloudflare)
TRUST_PROXY=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Gerado com: openssl rand -base64 48 — nunca reuse entre ambientes
EDITOR_API_TOKEN=replace-with-openssl-rand-base64-48-output
# Chave HMAC dos tokens de acesso a pedidos (anti-IDOR). Gerar com: openssl rand -base64 48
ORDER_ACCESS_SECRET=replace-with-openssl-rand-base64-48-output
# Horas até um pedido PENDING não pago ser cancelado e o estoque devolvido
ORDER_TTL_HOURS=24
# LGPD: dias até remover PII de pedidos finalizados (0 = desligado — decida antes de produzir)
RETENTION_DAYS=0
# Compatibilidade com instalações antigas:
ADMIN_API_TOKEN=
CORREIOS_BASE_URL=
CORREIOS_CLIENT_ID=
CORREIOS_CLIENT_SECRET=
CORREIOS_CONTRACT_NUMBER=
EMAIL_ENC_KEY=replace-with-openssl-rand-base64-48-output
LOG_LEVEL=info
